<!DOCTYPE html>
<html lang="pl">
<head>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-H4STML91ZV"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-H4STML91ZV');
    </script>
    
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Puchar Polski Amatorów w Szachach - Cykl 7 turniejów w całej Polsce. Dołącz do największego wydarzenia szachowego dla amatorów!" />
    <title>@(ViewData["Title"]?.ToString() == "Strona Główna" ? "Puchar Polski Amatorów" : $"{ViewData["Title"]} - Puchar Polski Amatorów")</title>
    
    <!-- Favicon -->
    <link rel="icon" type="image/png" href="~/sources/favicon.png" />
    <link rel="apple-touch-icon" href="~/sources/favicon.png" />
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @RenderBody()

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
