@page
@model IndexModel
@{
    ViewData["Title"] = "Strona Główna";
}

<!-- Hero Section -->
<section class="hero" id="hero">
    <video id="hero-video" class="hero-video" autoplay muted loop playsinline preload="metadata">
        <source id="hero-video-source" src="~/sources/film_arche.mp4" type="video/mp4">
    </video>
    <img id="hero-image" class="hero-image" src="~/sources/arche_znin.jpg" alt="Arche Żnin" style="display: none;">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <img src="~/sources/arche.svg" alt="Arche" class="hero-logo animate-fade-in">
        <h1 class="hero-title animate-fade-in">Puchar Polski Amatorów<br>w Szachach</h1>
        <p class="hero-subtitle animate-fade-in-delay">1 cykl • 6 miast • 7 lokalizacji • 10 turniejów • ponad 100 000 zł w puli nagród</p>
        <div class="hero-buttons animate-fade-in-delay-2">
            <a href="#turnieje" class="btn-primary">Terminy i lokalizacje</a>
        </div>
    </div>
    <div class="scroll-indicator animate-bounce">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M7 13l5 5 5-5M7 6l5 5 5-5"/>
        </svg>
    </div>
</section>

<!-- Info Section -->
<section class="info-section" id="info">
    <div class="container">
        <div class="info-content animate-on-scroll">
            <h2 class="section-title">O Pucharze Polski Amatorów</h2>
            <p class="info-text">
                Bez względu na to, czy masz 5 czy 75 lat, czy grałeś już wcześniej w turniejach czy nie – Arche Puchar Polski Amatorów jest dla Ciebie. To cykl ogólnopolskich rozgrywek dla pasjonatów królewskiej gry, z pulą nagród przekraczającą 100 000 zł.
            </p>
            <p class="info-text">
                W każdym z siedmiu turniejów rywalizujemy w różnych tempach – turnieje klasyczne, rapid i blitz, z odrębnym systemem punktacji oraz klasyfikacją generalną obejmującą cały cykl.
            </p>
            <p class="info-text">
                Każdy etap jest transmitowany na żywo na <a href="https://www.youtube.com/@@PolskiZwiazekSzachowy" target="_blank" rel="noopener noreferrer" class="info-link">YouTube</a>, dzięki czemu kibice mogą śledzić emocje przy szachownicach od pierwszego ruchu do ostatniego mata.
            </p>
            
            <!-- Ranking divisions -->
            <div class="ranking-divisions">
                <h3 class="ranking-title">Klasyfikacja generalna – grupy rankingowe</h3>
                <p class="ranking-description">Z wyjątkiem Columbus Mistrzostw Polski Amatorów, turnieje nie będą dzielone na grupy rankingowe (wszyscy grają ze sobą). Klasyfikacja generalna punktacji za każdy turniej będzie naliczona osobno. Poniżej zasady i aktualni liderzy.</p>
                <div class="ranking-badges">
                    <span class="ranking-badge ranking-badge--beginner">Grupa A: 0–1600</span>
                    <span class="ranking-badge ranking-badge--intermediate">Grupa B: 1601–1900</span>
                    <span class="ranking-badge ranking-badge--advanced">Grupa C: 1901–2200</span>
                </div>
            </div>
            
            <!-- Scoring System -->
            <div class="scoring-section">
                <h3 class="scoring-title">Punktacja</h3>
                <p class="scoring-description">Punkty zdobyte w poszczególnych turniejach trafiają do klasyfikacji generalnej. W zależności od tempa gry obowiązuje inna skala punktowa.</p>
                
