@page "/galeria"
@model GaleriaModel
@{
    ViewData["Title"] = "Galeria";
}

<section class="galeria-page">
    <div class="container">
        <a href="/#turnieje" class="galeria-back">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            Wróć na stronę główną
        </a>
        <h1 class="galeria-title">Galeria</h1>
        <p class="galeria-subtitle">Arche Puchar Polski Amatorów w Szachach</p>

        <div class="galeria-grid">
            @foreach (var src in Model.Images)
            {
                <button class="galeria-item" data-src="@src">
                    <img src="@src" alt="" loading="lazy" class="galeria-thumb">
                </button>
            }
        </div>
    </div>
</section>

<!-- Lightbox -->
<div class="lightbox" id="lightbox" hidden>
    <div class="lightbox__backdrop"></div>
    <button class="lightbox__close" aria-label="Zamknij">&times;</button>
    <button class="lightbox__arrow lightbox__arrow--prev" aria-label="Poprzednie">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lightbox__arrow lightbox__arrow--next" aria-label="Następne">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
    </button>
    <img class="lightbox__img" id="lightbox-img" src="" alt="">
</div>

@section Scripts {
<script>
(function() {
    var items = document.querySelectorAll('.galeria-item');
    var lightbox = document.getElementById('lightbox');
    var lbImg = document.getElementById('lightbox-img');
    var srcs = Array.from(items).map(function(el) { return el.dataset.src; });
    var currentIdx = 0;

    function open(idx) {
        currentIdx = idx;
        lbImg.src = srcs[currentIdx];
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
    }

    function close() {
        lightbox.hidden = true;
        lbImg.src = '';
        document.body.style.overflow = '';
    }

    function go(delta) {
        currentIdx = ((currentIdx + delta) % srcs.length + srcs.length) % srcs.length;
        lbImg.src = srcs[currentIdx];
    }

    items.forEach(function(el, i) {
        el.addEventListener('click', function() { open(i); });
    });

    lightbox.querySelector('.lightbox__backdrop').addEventListener('click', close);
    lightbox.querySelector('.lightbox__close').addEventListener('click', close);
    lightbox.querySelector('.lightbox__arrow--prev').addEventListener('click', function() { go(-1); });
    lightbox.querySelector('.lightbox__arrow--next').addEventListener('click', function() { go(1); });

    document.addEventListener('keydown', function(e) {
        if (lightbox.hidden) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') go(-1);
        if (e.key === 'ArrowRight') go(1);
    });
})();
</script>
}
